# =============================================================================
# Zscaler Lab Kit – Environment Configuration
# =============================================================================
#
# Copy this file to ".env" in the repository root and customise the values
# to match your own lab.  The ".env" file is git-ignored so your personal
# IP addresses and hostnames will never be pushed to GitHub.
#
#   cp .env.example .env
#   nano .env          # edit to match your lab
#
# Every variable below has a sensible default that matches the reference lab
# described in the documentation.  Override only what differs in your setup.
# =============================================================================

# ── Network Topology ─────────────────────────────────────────────────────────
# Windows Server (runs internal web apps, file shares, RDP)
WINDOWS_SERVER_IP=192.168.1.20

# Ubuntu / Linux Server (runs App Connector, decoy services)
LINUX_SERVER_IP=192.168.1.10

# Lab subnet (used by attacker-simulation scripts for recon sweeps)
LAB_SUBNET=192.168.1
LAB_SUBNET_CIDR=192.168.1.0/24
